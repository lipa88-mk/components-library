{
    "name": "components-library",
    "version": "0.0.1",
    "private": true,
    "description": "A React UI component library built with Tailwind CSS v4 and documented in Storybook.",
    "license": "MIT",
    "author": "Maria Korshunova",
    "repository": {
        "type": "git",
        "url": "https://github.com/mariakorsh/components-library.git"
    },
    "engines": {
        "node": ">=20"
    },
    "module": "./dist/index.mjs",
    "types": "dist/src/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./theme.css": {
            "import": "./dist/theme.css",
            "require": "./dist/theme.css"
        },
        "./index.css": {
            "import": "./dist/index.css",
            "require": "./dist/index.css"
        }
    },
    "scripts": {
        "prepare": "husky",
        "test": "jest",
        "test:ci": "jest --coverage --reporters=default --reporters=jest-junit --ci",
        "test:visual": "./visual-tests/docker-run.sh",
        "test:visual:ci": "./visual-tests/entrypoint.sh",
        "storybook": "storybook dev -p 6006",
        "build": "vite build",
        "tokens": "node tokens/index.mjs",
        "storybook:build": "storybook build",
        "lint": "eslint --cache --cache-location ${HOME}/.eslintcachecomponents/ -c .eslintrc.js .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "plop": "plop",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@jsonforms/core": "~3.5.1",
        "@jsonforms/react": "~3.5.1",
        "react": "^18",
        "react-dom": "^18"
    },
    "overrides": {
        "@floating-ui/core": "1.6.5",
        "@floating-ui/dom": "1.6.8",
        "@react-aria/focus": "3.20.2",
        "@react-aria/interactions": "3.25.0",
        "@tanstack/react-virtual": "3.13.8"
    },
    "jest-junit": {
        "outputDirectory": "tests",
        "outputName": "components.xml"
    },
    "lint-staged": {
        "*.{ts,tsx}": "eslint",
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@floating-ui/react": "0.27.20",
        "@headlessui/react": "2.2.10",
        "@heroicons/react": "^2.2.0",
        "ajv": "^8.17.1",
        "classnames": "^2.5.1",
        "lodash": "^4.17.21",
        "luxon": "^2.5.2",
        "nanoid": "3.3.11",
        "tailwind-merge": "2.6.0",
        "tailwind-variants": "0.3.1"
    },
    "devDependencies": {
        "@jsonforms/core": "~3.5.1",
        "@jsonforms/react": "~3.5.1",
        "@jsonforms/vanilla-renderers": "~3.5.1",
        "@puppeteer/browsers": "2.13.2",
        "@storybook/addon-actions": "8.6.18",
        "@storybook/addon-essentials": "8.6.18",
        "@storybook/addon-interactions": "8.6.18",
        "@storybook/addon-links": "8.6.18",
        "@storybook/addon-themes": "8.6.18",
        "@storybook/blocks": "8.6.18",
        "@storybook/manager-api": "8.6.18",
        "@storybook/react": "8.6.18",
        "@storybook/react-vite": "8.6.18",
        "@storybook/test": "8.6.18",
        "@storybook/theming": "8.6.18",
        "@swc/core": "^1.11.24",
        "@swc/jest": "^0.2.38",
        "@tailwindcss/vite": "^4.1.11",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@tokens-studio/sd-transforms": "1.3.0",
        "@types/jest": "^29.5.14",
        "@types/jest-image-snapshot": "6.4.1",
        "@types/lodash": "^4.17.16",
        "@types/luxon": "^2.4.0",
        "@types/react": "18.3.21",
        "@types/react-dom": "18.3.7",
        "@typescript-eslint/eslint-plugin": "8.70.0",
        "@typescript-eslint/parser": "8.70.0",
        "@vitejs/plugin-react": "4.7.0",
        "eslint": "^8.57.1",
        "http-server": "14.1.1",
        "husky": "9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-image-snapshot": "6.5.2",
        "jest-junit": "^16.0.0",
        "jest-puppeteer": "11.0.0",
        "lint-staged": "^15.5.2",
        "plop": "^4.0.1",
        "prettier": "^3.5.3",
        "puppeteer": "24.43.1",
        "puppeteer-core": "24.43.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "resize-observer-polyfill": "^1.5.1",
        "storybook": "8.6.18",
        "style-dictionary": "4.4.0",
        "tailwindcss": "^4.1.11",
        "typescript": "5.9.3",
        "vite": "6.4.3",
        "vite-plugin-checker": "0.9.3",
        "vite-plugin-dts": "4.5.4",
        "vite-plugin-static-copy": "2.3.1",
        "wait-on": "8.0.3"
    }
}
