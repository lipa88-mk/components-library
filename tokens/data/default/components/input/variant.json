{
  "input": {
    "default": {
      "bg": {
        "default": {
          "$type": "color",
          "$value": "{bg.page}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{bg.disabled}"
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{border.soft}"
        },
        "hover": {
          "$type": "color",
          "$value": "{accent.soft}"
        },
        "focus": {
          "$type": "color",
          "$value": "{accent.hover}"
        }
      },
      "text": {
        "default": {
          "$type": "color",
          "$value": "{fg.default}"
        },
        "placeholder": {
          "$type": "color",
          "$value": "{fg.muted}"
        }
      },
      "icon": {
        "default": {
          "$type": "color",
          "$value": "{fg.muted}"
        }
      }
    },
    "danger": {
      "border": {
        "default": {
          "$type": "color",
          "$value": "{danger.soft}"
        },
        "hover": {
          "$type": "color",
          "$value": "{danger.soft}"
        },
        "focus": {
          "$type": "color",
          "$value": "{danger.hover}"
        }
      }
    }
  }
}