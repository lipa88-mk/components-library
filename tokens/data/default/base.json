{
  "base": {
    "black": {
      "$type": "color",
      "$value": "#000"
    },
    "white": {
      "$type": "color",
      "$value": "#fff"
    },
    "accent": {
      "$type": "color",
      "$value": "#0055FF",
      "$description": "The basic color value, from which the accent palette is calculated"
    },
    "neutral": {
      "$type": "color",
      "$value": "#445371",
      "$description": "The basic color value, from which the secondary palette is calculated"
    },
    "success": {
      "$type": "color",
      "$value": "#019F3C",
      "$description": "The basic color value, from which the success palette is calculated"
    },
    "warning": {
      "$type": "color",
      "$value": "#F29100",
      "$description": "The basic color value, from which the warning palette is calculated "
    },
    "danger": {
      "$type": "color",
      "$value": "#D91528",
      "$description": "The basic color value, from which the danger palette is calculated "
    },
    "info": {
      "$type": "color",
      "$value": "#1998FF",
      "$description": "The basic color value, from which the info palette is calculated "
    },
    "none": {
      "$extensions": {
        "studio.tokens": {
          "modify": {
            "type": "alpha",
            "value": "0",
            "space": "srgb"
          }
        }
      },
      "$type": "color",
      "$value": "{base.white}",
      "$description": "Token for the value 'none'. Used in Figma, since even with 'none' the token must be assigned. When transforming tokens from json to CSS, the variables are replaced with none"
    }
  },
  "modifier": {
    "10": {
      "$type": "color",
      "$value": "0.97",
      "$description": "lighten"
    },
    "25": {
      "$type": "color",
      "$value": "0.95",
      "$description": "lighten"
    },
    "50": {
      "$type": "color",
      "$value": "0.9",
      "$description": "lighten"
    },
    "75": {
      "$type": "color",
      "$value": "0.83",
      "$description": "lighten"
    },
    "100": {
      "$type": "color",
      "$value": "0.75",
      "$description": "lighten"
    },
    "200": {
      "$type": "color",
      "$value": "0.5",
      "$description": "lighten"
    },
    "300": {
      "$type": "color",
      "$value": "0.35",
      "$description": "lighten"
    },
    "400": {
      "$type": "color",
      "$value": "0.2",
      "$description": "lighten"
    },
    "600": {
      "$type": "color",
      "$value": "0.15",
      "$description": "darken"
    },
    "650": {
      "$type": "color",
      "$value": "0.225",
      "$description": "darken"
    },
    "700": {
      "$type": "color",
      "$value": "0.3",
      "$description": "darken"
    },
    "800": {
      "$type": "color",
      "$value": "0.4",
      "$description": "darken"
    },
    "900": {
      "$type": "color",
      "$value": "0.5",
      "$description": "darken"
    },
    "925": {
      "$type": "color",
      "$value": "0.57",
      "$description": "darken"
    },
    "950": {
      "$type": "color",
      "$value": "0.65",
      "$description": "darken"
    },
    "990": {
      "$type": "color",
      "$value": "0.8",
      "$description": "darken"
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamilies",
        "$value": "Manrope",
        "$description": "Basic font family"
      },
      "display": {
        "$type": "fontFamilies",
        "$value": "{font.family.base}",
        "$description": "Гарнитура для display типографики"
      },
      "heading": {
        "$type": "fontFamilies",
        "$value": "{font.family.base}",
        "$description": "Гарнитура для heading типографики"
      },
      "body": {
        "$type": "fontFamilies",
        "$value": "{font.family.base}",
        "$description": "Гарнитура для body типографики"
      },
      "description": {
        "$type": "fontFamilies",
        "$value": "{font.family.base}",
        "$description": "Гарнитура для description типографики"
      }
    },
    "weight": {
      "bold": {
        "$type": "fontWeights",
        "$value": "800",
        "$description": "Font weight for bold styles"
      },
      "semibold": {
        "$type": "fontWeights",
        "$value": "600",
        "$description": "Font weight for bold or medium weights"
      },
      "regular": {
        "$type": "fontWeights",
        "$value": "400",
        "$description": "Font weight for normal styles"
      }
    },
    "size": {
      "base": {
        "$type": "fontSizes",
        "$value": "16",
        "$description": "The base value from which the font-sizes scale is calculated"
      }
    },
    "line-height": {
      "base": {
        "$type": "lineHeights",
        "$value": "{font.size.base}",
        "$description": "The base value from which the line-height scale is calculated"
      }
    }
  },
  "border-radius": {
    "base": {
      "$type": "borderRadius",
      "$value": "6",
      "$description": "The base value from which the rounding scale is calculated"
    }
  },
  "shadow": {
    "none": {
      "$type": "boxShadow",
      "$value": {
        "x": "0",
        "y": "0",
        "blur": "0",
        "spread": "0",
        "color": "{base.none}",
        "type": "innerShadow"
      },
      "$description": "Token for the value none. Used in Figma, since even with none the token must be assigned. When transforming tokens from json to CSS, the variables are replaced with none"
    }
  }
}