{
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["jest", "node"],
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "isolatedModules": true,
        "diagnostics": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true
    },
    "include": ["src", ".storybook/**/*", "./jest.setup.ts", "./package.json", "./jest/visual/jest.setup.ts"]
}
